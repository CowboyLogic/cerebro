{
  "name": "ai-artifact-installer",
  "version": "1.0.0",
  "description": "Install AI components (agents, skills, prompts, instructions) from GitHub into your favorite IDE",
  "type": "module",
  "bin": {
    "ai-install": "./bin/ai-install.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "chmod +x bin/ai-install.js 2>/dev/null || true"
  },
  "keywords": [
    "ai",
    "cli",
    "installer",
    "claude",
    "copilot",
    "vscode",
    "opencode",
    "skills",
    "agents",
    "prompts"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
