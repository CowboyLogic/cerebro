{
  "name": "cerebro",
  "version": "0.1.0",
  "description": "Install AI components (agents, skills, prompts, instructions) from GitHub into your favorite IDE",
  "type": "module",
  "bin": {
    "cerebro": "./bin/ai-install.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "node -e \"try{require('node:fs').chmodSync('bin/ai-install.js',0o755)}catch{}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:cli": "vitest run tests/cli"
  },
  "keywords": [
    "ai",
    "cli",
    "installer",
    "claude",
    "copilot",
    "vscode",
    "opencode",
    "skills",
    "agents",
    "prompts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cowboylogic/cerebro-schema": "file:../cerebro-schema",
    "@inquirer/prompts": "^8.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^4.1.0",
    "memfs": "^4.56.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
